rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'a01286527377@gmail.com' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // =================== SERVICES ===================
    match /services/{serviceId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admin can create, update, or delete services
    }

    // =================== USERS ===================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation on signup (must start with 0 balance)
      allow create: if isOwner(userId) && 
                      request.resource.data.balance == 0 && 
                      (request.resource.data.role == 'user' || (request.auth.token.email == 'a01286527377@gmail.com' && request.resource.data.role == 'admin'));
      
      // Allow users to update their own profile, but NOT increase their balance
      allow update: if isAdmin() || 
                      (isOwner(userId) && 
                       // Ensure they don't change their role
                       request.resource.data.role == resource.data.role &&
                       // Prevent them from increasing their balance (they can only spend/decrement it)
                       request.resource.data.balance <= resource.data.balance);
                       
      allow delete: if isAdmin();
    }

    // =================== TRANSACTIONS ===================
    match /transactions/{transactionId} {
      // Users can only read their own transactions, admin reads all
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // Users can log purchases, admin can write anything
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =================== DEPOSIT REQUESTS ===================
    match /deposit_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =================== NOTIFICATIONS ===================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow users to mark their own notifications as read
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid && 
                      request.resource.data.read == true && 
                      request.resource.data.title == resource.data.title; // prevent changing payload
                      
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // =================== SETTINGS ===================
    match /settings/payment {
      allow read: if true; // Public payment numbers
      allow write: if isAdmin();
    }

    match /settings/secrets {
      allow read: if isAdmin(); // Strictly restricted! Regular users cannot read tokens
      allow write: if isAdmin();
    }

    match /settings/orderCounter {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Any logged-in user can increment the counter
    }

    // =================== DEPRECATED PUSH TOKENS ===================
    // Block all legacy push token accesses just in case
    match /admin_push_tokens/{document} {
      allow read, write: if false;
    }
    match /user_push_tokens/{document} {
      allow read, write: if false;
    }
  }
}
